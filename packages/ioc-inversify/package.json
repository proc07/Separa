{
  "name": "@separa/ioc-inversify",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @separa/core",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@separa/core": "workspace:*",
    "inversify": "^7.5.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
