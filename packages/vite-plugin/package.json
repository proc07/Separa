{
  "name": "@separa/vite-plugin",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js",
      "default": "./dist/webpack.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js",
      "default": "./dist/rspack.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js",
      "default": "./dist/rollup.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js",
      "default": "./dist/esbuild.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/vite.ts src/webpack.ts src/rspack.ts src/rollup.ts src/esbuild.ts --format esm --dts --clean --external typescript --external vite --external webpack --external @rspack/core --external rollup --external esbuild --external unplugin",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "typescript": "^5.8.3",
    "unplugin": "^3.3.0"
  },
  "peerDependencies": {
    "@rspack/core": ">=1.0.0",
    "esbuild": ">=0.18.0",
    "rollup": ">=3.0.0",
    "vite": ">=5.0.0",
    "webpack": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rspack/core": "^2.2.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "rollup": "^4.63.1",
    "tsup": "^8.5.0",
    "vite": "^6.3.5",
    "webpack": "^5.110.2"
  }
}

