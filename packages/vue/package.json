{
  "name": "@separa/vue",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external vue --external @separa/core",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@separa/core": "workspace:*",
    "vue": ">=3.4"
  },
  "devDependencies": {
    "@separa/core": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vue": "^3.5.13"
  }
}
